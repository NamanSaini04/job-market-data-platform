# Copy to .env and fill in. Never commit .env.
REED_API_KEY=

# Optional, deferred to v2. Leave empty unless you add Adzuna later.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Postgres (Phase 2). Used by BOTH docker compose and the Python code.
# Set the password BEFORE the first `docker compose up`: Postgres only reads it
# when the database is first created.
PGHOST=localhost
PGPORT=5433
PGUSER=jobs
PGPASSWORD=
PGDATABASE=jobmarket
